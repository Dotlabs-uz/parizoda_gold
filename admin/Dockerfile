FROM node:21.6.2-alpine

COPY ./package*.json ./pre_build/
RUN npm install -f --prefix /pre_build

COPY . ./pre_build

ARG NODE_ENV

ARG DATABASE_URL
ARG TELEGRAM_BOT_TOKEN
ARG TG_ADMIN_BOT_TOKEN
ARG TG_SUPERADMIN_ID
ARG OTP_EXPIRATION_MINUTES
ARG ALLOWED_ORIGIN
ARG JWT_SECRET
ARG ADMIN_JWT_SECRET
ARG GCS_KEY_BASE64
ARG GCS_PROJECT_ID
ARG MULTICARD_URL
ARG MULTICARD_APP_ID
ARG MULTICARD_SECRET
ARG MULTICARD_STORE_ID
ARG MULTICARD_CALBACK_URL
ARG DATABASE_URL

ENV TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
ENV TG_ADMIN_BOT_TOKEN=${TG_ADMIN_BOT_TOKEN}
ENV TG_SUPERADMIN_ID=${TG_SUPERADMIN_ID}
ENV OTP_EXPIRATION_MINUTES=${OTP_EXPIRATION_MINUTES}
ENV ALLOWED_ORIGIN=${ALLOWED_ORIGIN}
ENV JWT_SECRET=${JWT_SECRET}
ENV ADMIN_JWT_SECRET=${ADMIN_JWT_SECRET}
ENV GCS_KEY_BASE64=${GCS_KEY_BASE64}
ENV GCS_PROJECT_ID=${GCS_PROJECT_ID}
ENV MULTICARD_URL=${MULTICARD_URL}
ENV MULTICARD_APP_ID=${MULTICARD_APP_ID}
ENV MULTICARD_SECRET=${MULTICARD_SECRET}
ENV MULTICARD_STORE_ID=${MULTICARD_STORE_ID}
ENV MULTICARD_CALBACK_URL=${MULTICARD_CALBACK_URL}

ENV NODE_ENV=${NODE_ENV}

RUN npm run build --prefix /pre_build
RUN cd /pre_build && npx prisma generate

RUN mkdir -p /build/

RUN cp -R pre_build/.next /build/.next
RUN cp -R pre_build/node_modules /build/node_modules
RUN cp -R pre_build/package.json /build/package.json
RUN cp -R pre_build/public /build/public
RUN cp -R pre_build/next.config.ts /build/next.config.ts
RUN cp -R pre_build/prisma /build/prisma

RUN rm -r /pre_build

CMD [ "npm", "run", "start", "--prefix", "./build" ]
EXPOSE 3000